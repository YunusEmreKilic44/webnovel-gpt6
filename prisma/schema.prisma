generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Announcement {
  id        String   @id
  title     String
  body      String
  /// Ordered text/image blocks. body is the searchable plain-text projection.
  content   Json?
  linkPath  String   @default("") @map("link_path")
  linkLabel String   @default("") @map("link_label")
  published Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([published, position])
  @@map("announcements")
}

model HomeSlide {
  id            String   @id
  title         String
  description   String   @default("")
  linkPath      String   @default("") @map("link_path")
  linkLabel     String   @default("") @map("link_label")
  imagePreset   String   @default("hero") @map("image_preset")
  /// Legacy in-database image; new uploads go to Cloudinary (imageUrl).
  imageData     Bytes?   @map("image_data")
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")
  imageAlt      String   @default("") @map("image_alt")
  published     Boolean  @default(false)
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([published, position])
  @@map("home_slides")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_id_user_id_fk")

  @@map("account")
}

model Application {
  id         String    @id
  bookId     String    @map("book_id")
  type       String
  status     String    @default("PENDING")
  snapshot   Json
  note       String    @default("")
  reviewerId String?   @map("reviewer_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  book       Book      @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "applications_book_id_books_id_fk")
  reviewer   User?     @relation(fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "applications_reviewer_id_user_id_fk")

  notifications Notification[]

  @@map("applications")
}

model AuditLog {
  id        String   @id
  actorId   String   @map("actor_id")
  action    String
  targetId  String   @map("target_id")
  detail    String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_logs_actor_id_user_id_fk")

  @@map("audit_logs")
}

model Book {
  id                     String            @id
  authorId               String            @map("author_id")
  slug                   String
  title                  String
  subtitle               String            @default("")
  description            String
  genres                 String[]
  /// Preset artwork; used when no cover image has been uploaded.
  cover                  String            @default("ember")
  coverUrl               String?           @map("cover_url")
  coverPublicId          String?           @map("cover_public_id")
  status                 String            @default("DRAFT")
  storyStatus            String            @default("ONGOING") @map("story_status")
  premiumStatus          String            @default("NONE") @map("premium_status")
  firstPremiumApprovedAt DateTime?         @map("first_premium_approved_at") @db.Timestamptz(6)
  hidden                 Boolean           @default(false)
  featured               Boolean           @default(false)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  author                 User              @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "books_author_id_user_id_fk")
  applications           Application[]
  chapters               Chapter[]
  comments               Comment[]
  libraryEntries         LibraryEntry[]
  ratings                Rating[]
  readingProgress        ReadingProgress[]
  volumes                Volume[]
  tags                   BookTag[]

  notifications Notification[]

  @@unique([slug], map: "books_slug_unique")
  @@index([status, hidden, updatedAt], map: "books_catalog_idx")
  @@index([authorId, updatedAt], map: "books_author_updated_idx")
  @@index([genres], type: Gin, map: "books_genres_idx")
  @@map("books")
}

/// Authors share tags by a normalized, case/accent-insensitive key.
model Tag {
  key   String    @id @db.VarChar(64)
  name  String    @db.VarChar(32)
  books BookTag[]

  @@map("tags")
}

model BookTag {
  bookId String @map("book_id")
  tagKey String @map("tag_key") @db.VarChar(64)
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagKey], references: [key], onDelete: Cascade)

  @@id([bookId, tagKey])
  @@index([tagKey, bookId], map: "book_tags_tag_book_idx")
  @@map("book_tags")
}

model ChapterRevision {
  id        String   @id
  chapterId String   @map("chapter_id")
  version   Int
  title     String
  content   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chapter_revisions_chapter_id_chapters_id_fk")

  @@unique([chapterId, version], map: "revision_version_idx")
  @@map("chapter_revisions")
}

model Chapter {
  id                 String            @id
  bookId             String            @map("book_id")
  volumeId           String            @map("volume_id")
  title              String
  position           Int
  content            Json
  publishedContent   Json?             @map("published_content")
  publishedTitle     String?           @map("published_title")
  wordCount          Int               @default(0) @map("word_count")
  publishedWordCount Int               @default(0) @map("published_word_count")
  status             String            @default("DRAFT")
  /// FREE, or PAID = premium: unlocked for the fixed CoinSettings price.
  accessType         String            @default("FREE") @map("access_type")
  firstPublishedAt   DateTime?         @map("first_published_at") @db.Timestamptz(6)
  version            Int               @default(1)
  hidden             Boolean           @default(false)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  book               Book              @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chapters_book_id_books_id_fk")
  volume             Volume            @relation("ChapterVolume", fields: [volumeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chapters_volume_id_volumes_id_fk")
  volumeBook         Volume            @relation("ChapterVolumeBook", fields: [volumeId, bookId], references: [id, bookId], onDelete: NoAction, onUpdate: NoAction, map: "chapter_volume_book_fk")
  chapterRevisions   ChapterRevision[]
  images             ChapterImage[]
  readingProgress    ReadingProgress[]
  reads              ChapterRead[]
  unlocks            ChapterUnlock[]
  coinTransactions   CoinTransaction[]

  notifications Notification[]

  @@unique([volumeId, position], map: "chapters_position_idx")
  @@index([bookId, status], map: "chapters_book_idx")
  @@map("chapters")
}

/// Private chapter media. Immutable so published/reviewed revisions keep their images.
model ChapterImage {
  id        String   @id
  chapterId String   @map("chapter_id")
  imageData Bytes    @map("image_data")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("chapter_images")
}

model ChapterRead {
  chapterId String   @map("chapter_id")
  viewerKey String   @map("viewer_key")
  readOn    DateTime @map("read_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([chapterId, viewerKey, readOn])
  @@map("chapter_reads")
}

model Comment {
  id        String        @id
  userId    String        @map("user_id")
  bookId    String        @map("book_id")
  body      String
  spoiler   Boolean       @default(false)
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "comments_user_id_user_id_fk")
  book      Book          @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "comments_book_id_books_id_fk")
  likes     CommentLike[]

  @@index([bookId, hidden, createdAt], map: "comments_book_visible_created_idx")
  @@map("comments")
}

model CommentLike {
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([commentId, userId])
  @@index([userId], map: "comment_likes_user_idx")
  @@map("comment_likes")
}

model LibraryEntry {
  id        String   @id
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "library_entries_user_id_user_id_fk")
  book      Book     @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "library_entries_book_id_books_id_fk")

  @@unique([userId, bookId], map: "library_user_book_idx")
  @@map("library_entries")
}

model RateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now()) @map("window_start") @db.Timestamptz(6)

  @@map("rate_limits")
}

model Rating {
  id        String   @id
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  score     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ratings_user_id_user_id_fk")
  book      Book     @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ratings_book_id_books_id_fk")

  @@unique([userId, bookId], map: "rating_user_book_idx")
  @@index([bookId], map: "ratings_book_idx")
  @@map("ratings")
}

model ReadingProgress {
  id        String   @id
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  chapterId String   @map("chapter_id")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reading_progress_user_id_user_id_fk")
  book      Book     @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reading_progress_book_id_books_id_fk")
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reading_progress_chapter_id_chapters_id_fk")

  @@unique([userId, bookId], map: "progress_user_book_idx")
  @@map("reading_progress")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_user_id_user_id_fk")

  @@unique([token], map: "session_token_unique")
  @@map("session")
}

model User {
  id              String            @id
  name            String
  email           String
  emailVerified   Boolean           @default(false) @map("email_verified")
  image           String?
  /// Profile picture on Cloudinary. Server-written only, unlike Better Auth's
  /// client-updatable `image`, so it can never point at an arbitrary URL.
  avatarUrl       String?           @map("avatar_url")
  avatarPublicId  String?           @map("avatar_public_id")
  /// Spendable coins. Only src/modules/coins changes it, always with a CoinTransaction.
  coinBalance     Int               @default(0) @map("coin_balance")
  role            String            @default("reader")
  banned          Boolean           @default(false)
  banReason       String            @default("") @map("ban_reason")
  bannedAt        DateTime?         @map("banned_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  accounts        Account[]
  applications    Application[]
  auditLogs       AuditLog[]
  books           Book[]
  comments        Comment[]
  commentLikes    CommentLike[]
  libraryEntries  LibraryEntry[]
  ratings         Rating[]
  readingProgress ReadingProgress[]
  sessions        Session[]
  coinOrders      CoinOrder[]
  coinTxns        CoinTransaction[]
  chapterUnlocks  ChapterUnlock[]

  notifications Notification[]

  reportsFiled   Report[] @relation("ReportReporter")
  reportsHandled Report[] @relation("ReportHandler")

  following              AuthorFollow[]   @relation("Follower")
  followers              AuthorFollow[]   @relation("FollowedAuthor")
  profileComments        ProfileComment[] @relation("ProfileOwner")
  writtenProfileComments ProfileComment[] @relation("ProfileCommenter")

  @@unique([email], map: "user_email_unique")
  @@map("user")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("verification")
}

model Volume {
  id           String    @id
  bookId       String    @map("book_id")
  title        String
  position     Int
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  book         Book      @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "volumes_book_id_books_id_fk")
  chapters     Chapter[] @relation("ChapterVolume")
  bookChapters Chapter[] @relation("ChapterVolumeBook")

  @@unique([bookId, position], map: "volumes_position_idx")
  @@unique([id, bookId], map: "volume_id_book_unique")
  @@map("volumes")
}

/// Singleton (id = 1): the fixed coin price of every premium chapter.
model CoinSettings {
  id                         Int      @id @default(1)
  chapterPriceCoins          Int      @default(5) @map("chapter_price_coins")
  /// A book may apply for premium once it has this many published chapters…
  premiumMinChapters         Int      @default(10) @map("premium_min_chapters")
  /// …and this many chapter reads (unique viewer per chapter per day).
  premiumMinReads            Int      @default(500) @map("premium_min_reads")
  /// Feature switches (admin panel → Özellikler). Off until launched.
  coinStoreEnabled           Boolean  @default(false) @map("coin_store_enabled")
  premiumApplicationsEnabled Boolean  @default(false) @map("premium_applications_enabled")
  updatedAt                  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("coin_settings")
}

/// A top-up offer: `coins` for `priceMinor` kuruş (TRY).
model CoinPackage {
  id         String      @id
  coins      Int
  priceMinor Int         @map("price_minor")
  active     Boolean     @default(true)
  position   Int         @default(0)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  orders     CoinOrder[]

  @@map("coin_packages")
}

/// One checkout. coins/priceMinor are copied from the package when ordered.
model CoinOrder {
  id                String           @id
  userId            String           @map("user_id")
  packageId         String?          @map("package_id")
  coins             Int
  priceMinor        Int              @map("price_minor")
  currency          String           @default("TRY")
  status            String           @default("PENDING")
  provider          String           @default("iyzico")
  providerToken     String?          @unique @map("provider_token")
  providerPaymentId String?          @map("provider_payment_id")
  failureReason     String           @default("") @map("failure_reason")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  paidAt            DateTime?        @map("paid_at") @db.Timestamptz(6)
  user              User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  package           CoinPackage?     @relation(fields: [packageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  transaction       CoinTransaction?

  @@index([userId, createdAt])
  @@map("coin_orders")
}

/// Append-only coin ledger; balanceAfter mirrors user.coinBalance after the move.
model CoinTransaction {
  id           String     @id
  userId       String     @map("user_id")
  amount       Int
  balanceAfter Int        @map("balance_after")
  kind         String
  orderId      String?    @unique @map("order_id")
  chapterId    String?    @map("chapter_id")
  note         String     @default("")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order        CoinOrder? @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chapter      Chapter?   @relation(fields: [chapterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@map("coin_transactions")
}

/// Permanent access to one premium chapter.
model ChapterUnlock {
  id         String   @id
  userId     String   @map("user_id")
  chapterId  String   @map("chapter_id")
  coinsSpent Int      @map("coins_spent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, chapterId])
  @@index([chapterId])
  @@map("chapter_unlocks")
}

/// In-app notice. NEW_CHAPTER: a book in the reader's library published a chapter.
model Notification {
  id            String       @id
  userId        String       @map("user_id")
  /// NEW_CHAPTER | APPLICATION_APPROVED | APPLICATION_REJECTED | REPORT_RESOLVED | REPORT_DISMISSED
  type          String
  bookId        String?      @map("book_id")
  chapterId     String?      @map("chapter_id")
  applicationId String?      @map("application_id")
  reportId      String?      @map("report_id")
  readAt        DateTime?    @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book          Book?        @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter       Chapter?     @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  report        Report?      @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, chapterId, type])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// A user's report about a book, chapter, comment or user (targetId is not a FK
/// so the moderation record outlives deleted content).
model Report {
  id             String    @id
  reporterId     String    @map("reporter_id")
  targetType     String    @map("target_type")
  targetId       String    @map("target_id")
  reason         String
  details        String    @default("")
  status         String    @default("OPEN")
  action         String    @default("NONE")
  resolutionNote String    @default("") @map("resolution_note")
  handledById    String?   @map("handled_by_id")
  handledAt      DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reporter       User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  handledBy      User?     @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  notifications Notification[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// A reader following an author (to hear about new books).
model AuthorFollow {
  followerId String   @map("follower_id")
  authorId   String   @map("author_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author     User     @relation("FollowedAuthor", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([followerId, authorId])
  @@index([authorId])
  @@map("author_follows")
}

/// A comment on a user's public profile page.
model ProfileComment {
  id            String   @id
  profileUserId String   @map("profile_user_id")
  authorId      String   @map("author_id")
  body          String
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profileUser   User     @relation("ProfileOwner", fields: [profileUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author        User     @relation("ProfileCommenter", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([profileUserId, createdAt])
  @@map("profile_comments")
}
