# Neon pooled connection for the application (keep TLS enabled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon direct connection for Prisma migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret of at least 32 characters for deployment.
BETTER_AUTH_SECRET=
# Only localhost + next dev (or an isolated E2E database) can skip verification.
DEV_SKIP_EMAIL_VERIFICATION=true
# Optional real email delivery:
RESEND_API_KEY=
EMAIL_FROM=
# Cloudinary: slide image uploads (Dashboard > Settings > API Keys).
# The secret is server-only; never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for uploads (slides go to <folder>/slides).
CLOUDINARY_FOLDER=satir
# Optional: docker compose up -d postgres-test
# TEST_DATABASE_URL=postgresql://satir:satir@localhost:5433/satir_e2e
