# Set DATABASE_URL for PostgreSQL. When absent, local PGlite persists in .data/.
# PGlite is allowed only with LOCAL_DATABASE=true and a single web process.
LOCAL_DATABASE=true
# DATABASE_URL=postgresql://satir:satir@localhost:5432/satir
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret of at least 32 characters for deployment.
BETTER_AUTH_SECRET=
# Development only: skip email verification until mail delivery is configured.
DEV_SKIP_EMAIL_VERIFICATION=true
# Optional real email delivery:
RESEND_API_KEY=
EMAIL_FROM=
